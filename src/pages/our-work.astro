---
import BaseLayout from '../layouts/BaseLayout.astro';

// Photos live in public/images/our-work/. To add a project's photos, drop the files there
// (named like seacoast-colonial-before-kitchen.webp) and list them under that project.
// "before" photos sit side by side; a photo marked wide spans the full width.
const projects = [
  {
    title: 'Seacoast Colonial — Full Gut Renovation',
    description: 'Complete structural and cosmetic renovation. New framing, flooring, kitchen, and bathrooms.',
    photos: [
      { file: 'seacoast-colonial-before-living-room.webp', width: 1200, height: 900, stage: 'before', caption: 'Before · Living room',
        alt: 'Before: the living room wall, with a small pass-through into the old kitchen' },
      { file: 'seacoast-colonial-before-kitchen.webp', width: 1200, height: 900, stage: 'before', caption: 'Before · Kitchen',
        alt: 'Before: the old galley kitchen with orange walls and dated cabinets' },
      { file: 'seacoast-colonial-after-kitchen.webp', width: 1440, height: 1152, stage: 'after', wide: true, caption: 'After · Wall removed, new open kitchen',
        alt: 'After: the wall is gone, opening onto a new kitchen with white cabinets, stone counters, stainless appliances and an island, with our dog in front' },
    ],
  },
  {
    title: 'Manchester Duplex — Flip to Rental',
    description: 'Converted a neglected duplex into two quality long-term rental units. New kitchens, baths, and mechanicals throughout.',
    photos: [],
  },
  {
    title: 'Keene Ranch — Quick Turnaround Flip',
    description: 'Cosmetic flip with kitchen remodel, new flooring, and full interior paint. Listed and sold within 30 days of completion.',
    photos: [],
  },
];
---

<BaseLayout
  title="Our Work — Before & After Renovations | Graves Properties NH"
  description="See before and after photos of Graves Properties renovation projects across New Hampshire. Full gut-rehabs, flips, and rental renovations by Tim & Katie Graves."
>

  <!-- HERO -->
  <section class="bg-slate-900 text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sky-400 text-sm tracking-widest uppercase mb-4">Portfolio</p>
      <h1 class="font-serif text-4xl md:text-5xl leading-tight mb-4">
        Our Work
      </h1>
      <p class="text-slate-300 text-lg max-w-2xl mx-auto">
        Before and after — every project tells a story. Here's a look at what
        we've been building across New Hampshire.
      </p>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-5xl mx-auto space-y-16">
      {projects.map((project, i) => (
        <>
          {i > 0 && <hr class="border-slate-100" />}
          <div>
            <h2 class="font-serif text-2xl text-slate-900 mb-2">{project.title}</h2>
            <p class:list={['text-gray-500 text-sm', project.photos.length > 0 && 'mb-6']}>{project.description}</p>
            {project.photos.length > 0 && (
              <div class="grid md:grid-cols-2 gap-4">
                {project.photos.map((photo) => (
                  <figure class:list={[photo.wide && 'md:col-span-2']}>
                    <img src={`/images/our-work/${photo.file}`} width={photo.width} height={photo.height} alt={photo.alt}
                         loading="lazy" decoding="async"
                         class:list={['rounded-xl w-full h-auto mb-2', photo.stage === 'after' && 'border-2 border-sky-200']} />
                    <figcaption class:list={['text-xs uppercase tracking-wider text-center',
                                             photo.stage === 'after' ? 'text-sky-700 font-semibold' : 'text-slate-500']}>
                      {photo.caption}
                    </figcaption>
                  </figure>
                ))}
              </div>
            )}
          </div>
        </>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-4 bg-slate-50 border-t border-slate-100">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-serif text-2xl text-slate-900 mb-3">Have a Property That Needs Work?</h2>
      <p class="text-gray-500 mb-6">
        We're always looking for our next project. If you have a property to sell — in any condition — get in touch.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+16037852811"
           class="bg-sky-700 hover:bg-sky-800 text-white font-semibold px-6 py-3 rounded-xl no-underline transition-colors">
          Call 603-785-2811
        </a>
        <a href="https://bestnhrealty.com"
           class="bg-slate-800 hover:bg-slate-900 text-white font-semibold px-6 py-3 rounded-xl no-underline transition-colors">
          Sell Your Home &rarr;
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
