---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Rentals Coming Soon | Graves Properties"
  description="Graves Properties rentals are coming soon: fully renovated, owner-managed homes in New Hampshire. Tell us what you need and we'll reach out first."
>

  <!-- HERO -->
  <section class="bg-slate-900 text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sky-400 text-sm tracking-widest uppercase mb-4">Rentals</p>
      <h1 class="font-serif text-4xl md:text-5xl leading-tight mb-4">
        Coming Soon
      </h1>
      <p class="text-slate-300 text-lg max-w-2xl mx-auto">
        Our rental homes are on the way. Every one will be fully renovated and owner-managed.
      </p>
    </div>
  </section>

  <!-- GET FIRST WORD -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-serif text-3xl text-slate-900 mb-3">Get First Word</h2>
      <p class="text-gray-500 max-w-xl mx-auto mb-8">
        Tell us what you're looking for (town, size, move-in date) and we'll reach out
        before anything is listed.
      </p>
      <div class="max-w-2xl mx-auto">
        <ContactForm topic="renting" />
      </div>
      <p class="text-gray-500 text-sm mt-6">
        Or call or text Tim at <a href="tel:+16037852811" class="text-sky-700 font-semibold">603-785-2811</a>
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-4 bg-slate-50 border-t border-slate-100">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-serif text-2xl text-slate-900 mb-3">Looking to Sell Instead?</h2>
      <p class="text-gray-500 mb-6">
        We buy houses for cash through Best NH Realty — fast closings, no hassle.
      </p>
      <a href="https://bestnhrealty.com"
         class="inline-block bg-slate-800 hover:bg-slate-900 text-white font-semibold px-6 py-3 rounded-xl no-underline transition-colors">
        Visit Best NH Realty &rarr;
      </a>
    </div>
  </section>

</BaseLayout>
